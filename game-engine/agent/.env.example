# Скопируйте в .env рядом с этим файлом и заполните.
# .env не коммитится — на каждом моноблоке свой ROOM_ID и STATION_API_KEY.

BACKEND_BASE_URL=https://api.oyna.pro/api
ROOM_ID=
STATION_API_KEY=
ROOM_API_BASE=http://127.0.0.1:8080/v1
ROOM_API_KEY=dev

# Пачки room-events в CRM (по умолчанию 20); long-poll limit с игры — EVENTS_FETCH_LIMIT=50
# EVENTS_CRM_BATCH_SIZE=20
# EVENTS_FETCH_LIMIT=50

# Если Python ругается на SSL сертификат CRM (браузер при этом открывает сайт):
# CRM_SSL_VERIFY=0
