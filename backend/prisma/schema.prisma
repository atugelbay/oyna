generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  OPERATOR
  MANAGER
  ADMIN
  CRM_EXTRA_1
  CRM_EXTRA_2
  CRM_EXTRA_3
  CRM_EXTRA_4
  CRM_EXTRA_5
}

enum LoyaltyStatus {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  LEGEND
}

enum VenueStatus {
  OPEN
  CLOSED
  MAINTENANCE
}

enum GameModeType {
  COOP
  COMPETITIVE
  FFA
}

enum SessionStatus {
  PENDING
  ACTIVE
  COMPLETED
  ERROR
  CANCELLED
}

enum TransactionType {
  PURCHASE
  BONUS
  PROMO
  GAME_DEBIT
  CORRECTION
}

enum TransactionSource {
  CASHIER
  ONLINE
  ADMIN
}

enum TournamentStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PromoStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

model User {
  id            String        @id @default(uuid())
  phone         String        @unique
  nickname      String        @unique
  name          String
  birthDate     DateTime?
  role          Role          @default(USER)
  loyaltyStatus LoyaltyStatus @default(BRONZE)
  totalScore    Int           @default(0)
  isActive      Boolean       @default(true)
  passwordHash  String?
  referralCode  String?       @unique
  referredById  String?
  birthDateLocked Boolean     @default(false)
  offerAcceptedAt DateTime?
  offerVersion  String?
  privacyAcceptedAt DateTime?
  privacyVersion String?
  guardianConfirmedAt DateTime?
  sourceCode    String?
  instagram     String?
  legendInvite  Boolean       @default(false)
  deletedAt     DateTime?
  mergedIntoId  String?
  phoneHash     String?
  blockedUntil  DateTime?
  blockStartedAt DateTime?
  blockPermanent Boolean      @default(false)
  blockReason   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  balance            AccountBalance?
  transactions       Transaction[]
  scores             Score[]
  sessions           GameSessionPlayer[]
  modeUnlocks        PlayerModeUnlock[]
  tournamentMembers  TournamentMember[]
  tournamentResults  TournamentResult[]
  staffVenues        StaffVenue[]
  minuteGrants       MinuteGrant[]
  minuteEntries      MinuteEntry[]

  @@index([phone])
  @@index([nickname])
  @@index([phoneHash])
  @@index([referralCode])
  @@map("users")
}

/**
 * Открытый уровень по внешнему mode_id Room API (megagrid.jumps → 5).
 * В POST /lobby/players уходит как unlocked: { "mode_id": level }.
 */
model PlayerModeUnlock {
  id             String @id @default(uuid())
  userId         String
  /** Внешний mode_id из каталога игры, напр. lasers.corridor */
  engineModeId   String
  /** Высший открытый уровень (≥1) */
  unlockedLevel  Int    @default(1)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, engineModeId])
  @@index([userId])
  @@map("player_mode_unlocks")
}

model AccountBalance {
  id               String @id @default(uuid())
  userId           String @unique
  availableSeconds Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_balances")
}

model Venue {
  id       String      @id @default(uuid())
  name     String
  city     String
  address  String
  timezone String      @default("Asia/Almaty")
  status   VenueStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms          Room[]
  transactions   Transaction[]
  sessions       GameSession[]
  tournaments    Tournament[]
  promos         Promo[]
  pricePackages  PricePackage[]
  accessCodes    VenueAccessCode[]
  staffVenues    StaffVenue[]

  @@map("venues")
}

model StaffVenue {
  id      String @id @default(uuid())
  userId  String
  venueId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, venueId])
  @@map("staff_venues")
}

model Room {
  id                   String @id @default(uuid())
  venueId              String
  name                 String
  type                 String
  maxPlayers           Int    @default(5)
  defaultLevelDuration Int    @default(120)

  /** bcrypt hash плоского ключа станции (Room Agent → /api/station/...) */
  stationApiKeyHash     String?
  lastHeartbeatAt       DateTime?
  heartbeatBuildVersion String?

  /** Room API v1: room_id из GET /v1/room (lasers, megagrid, …) */
  engineRoomId    String?
  /** catalog_hash из room_online / ответа каталога */
  catalogHash     String?
  /** Последний снимок GET /v1/catalog */
  catalogJson     Json?
  catalogSyncedAt DateTime?

  /** Токен QR лобби (мобильный join); url собирается из PLAYER_APP_PUBLIC_URL */
  lobbyJoinToken     String?
  lobbyJoinExpiresAt DateTime?

  /**
   * true = mock/virtual: агент шлёт /_dev/select и /_dev/start.
   * false (зал с железом) = только lobby/players; старт кнопкой на HUD.
   */
  useDevCommands Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue         Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  modes         GameMode[]
  sessions      GameSession[]
  scores        Score[]
  agentCommands RoomAgentCommand[]

  @@index([lobbyJoinToken])
  @@map("rooms")
}

model GameMode {
  id          String       @id @default(uuid())
  roomId      String
  type        GameModeType @default(COOP)
  name        String
  description String?
  config      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room     Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sessions GameSession[]
  scores   Score[]

  @@map("game_modes")
}

model Transaction {
  id               String            @id @default(uuid())
  /** Null for guest walk-in cash sales (no player account). */
  userId           String?
  type             TransactionType
  source           TransactionSource
  amountTenge      Int               @default(0)
  equivalentSeconds Int              @default(0)
  venueId          String?
  description      String?

  createdAt DateTime @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue? @relation(fields: [venueId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("transactions")
}

model GameSession {
  id              String        @id @default(uuid())
  roomId          String
  modeId          String
  venueId         String
  sessionToken    String        @unique @default(uuid())
  /** UUID сеанса из Room API v1 (session_started.session_id) */
  engineSessionId String?       @unique
  startTime       DateTime?
  endTime         DateTime?
  /** CRM «Пауза»: таймер заморожен, при возобновлении startTime сдвигается */
  pausedAt        DateTime?
  /** Секунды, списанные с баланса (по канону — 600 на session_started) */
  deductedSeconds Int           @default(0)
  /** Когда списали 10 мин на старте (идемпотентность) */
  balanceDebitedAt DateTime?
  /** Секунды оплаченных и бонусных, списанные на старте */
  paidSecondsDebited  Int @default(0)
  bonusSecondsDebited Int @default(0)
  /** false — турнир, тест, ручные минуты администратора */
  countsForRating Boolean @default(true)
  isTournament    Boolean @default(false)
  endReason       String?
  compensatedAt   DateTime?
  launchedById    String?
  status          SessionStatus @default(PENDING)

  createdAt DateTime @default(now())

  room    Room              @relation(fields: [roomId], references: [id])
  mode    GameMode          @relation(fields: [modeId], references: [id])
  venue   Venue             @relation(fields: [venueId], references: [id])
  players       GameSessionPlayer[]
  scores        Score[]
  agentCommands RoomAgentCommand[]
  matchReports  SessionMatchReport[]

  @@index([sessionToken])
  @@index([status])
  @@map("game_sessions")
}

/** Очередь команд CRM → Room Agent (long-poll / polling). */
model RoomAgentCommand {
  id          String    @id @default(uuid())
  roomId      String
  sessionId   String?
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  room    Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  session GameSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([roomId, deliveredAt])
  @@map("room_agent_commands")
}

/** Идемпотентный приём отчёта об уровне от агента (дедуп по session+level+attempt). */
model SessionMatchReport {
  id              String   @id @default(uuid())
  sessionId       String
  level           Int
  attemptNumber   Int
  result          Json
  durationSeconds Int?
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, level, attemptNumber])
  @@map("session_match_reports")
}

model GameSessionPlayer {
  id        String @id @default(uuid())
  sessionId String
  userId    String

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@map("game_session_players")
}

model Score {
  id        String @id @default(uuid())
  userId    String
  sessionId String
  roomId    String
  modeId    String
  score     Int

  createdAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  room    Room        @relation(fields: [roomId], references: [id])
  mode    GameMode    @relation(fields: [modeId], references: [id])

  @@index([userId])
  @@index([roomId])
  @@index([score])
  @@index([createdAt])
  @@map("scores")
}

// ─── Tournaments ─────────────────────────────────────────

model Tournament {
  id          String           @id @default(uuid())
  name        String
  description String?
  venueId     String
  dateStart   DateTime
  dateEnd     DateTime
  maxTeams    Int              @default(10)
  status      TournamentStatus @default(UPCOMING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue   Venue              @relation(fields: [venueId], references: [id])
  teams   TournamentTeam[]
  results TournamentResult[]

  @@index([venueId])
  @@index([status])
  @@map("tournaments")
}

model TournamentTeam {
  id               String @id @default(uuid())
  tournamentId     String
  name             String
  participantsCount Int   @default(0)

  createdAt DateTime @default(now())

  tournament Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  members    TournamentMember[]
  results    TournamentResult[]

  @@map("tournament_teams")
}

model TournamentMember {
  id        String  @id @default(uuid())
  teamId    String
  userId    String
  isCaptain Boolean @default(false)

  team TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@map("tournament_members")
}

model TournamentResult {
  id           String  @id @default(uuid())
  tournamentId String
  teamId       String?
  userId       String?
  rank         Int
  score        Int     @default(0)

  tournament TournamentTeam? @relation(fields: [teamId], references: [id])
  team       Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User?           @relation(fields: [userId], references: [id])

  @@map("tournament_results")
}

// ─── Promos ──────────────────────────────────────────────

model Promo {
  id          String      @id @default(uuid())
  title       String
  headline    String?
  description String?
  type        String
  reward      String?
  quantity    String?
  dateStart   DateTime
  dateEnd     DateTime?
  status      PromoStatus @default(ACTIVE)
  venueId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue Venue? @relation(fields: [venueId], references: [id])

  @@index([status])
  @@index([venueId])
  @@map("promos")
}

// ─── Settings ────────────────────────────────────────────

model PricePackage {
  id               String @id @default(uuid())
  venueId          String
  name             String
  minutes          Int
  /** Цена в будни */
  costTenge        Int
  /** Цена в выходные; если null — равна будням */
  costWeekendTenge Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("price_packages")
}

model LoyaltyLevel {
  id            String @id @default(uuid())
  name          String @unique
  minPoints     Int
  bonusMinutes  Int    @default(0)
  colorGradient String @default("")
  colorBg       String @default("")
  sortOrder     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("loyalty_levels")
}

model RolePermission {
  id            String  @id @default(uuid())
  role          Role
  permissionKey String
  enabled       Boolean @default(true)

  @@unique([role, permissionKey])
  @@map("role_permissions")
}

/** Пользовательское отображаемое имя роли в CRM (идентификатор Role в enum не меняется) */
model RoleCustomLabel {
  role      Role   @id
  label     String
  updatedAt DateTime @updatedAt

  @@map("role_custom_labels")
}

/** Доп. CRM-роли (слоты CRM_EXTRA_*) созданы владельцем и участвуют в матрице прав */
model CrmProvisionedRole {
  role      Role     @id
  createdAt DateTime @default(now())

  @@map("crm_provisioned_roles")
}

model VenueAccessCode {
  id      String @id @default(uuid())
  venueId String
  role    Role
  code    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, role])
  @@map("venue_access_codes")
}

// ─── TZ 29.10: ledger, cash, loyalty, bookings ───────────

enum MinuteKind {
  PAID
  BONUS
  REWARD
  COMPENSATION
  MANUAL
  LEGACY_UNKNOWN
}

enum MinuteEntryType {
  CREDIT
  DEBIT
  EXPIRE
  CANCEL
}

enum PayMethod {
  CASH
  KASPI
  HALYK
  FREEDOM
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum CatalogCategory {
  GAMES
  PACKAGES
  PROMO
  WATER
  OTHER
  CERTIFICATE
}

enum CashMoveType {
  IN
  OUT
  EXPENSE
}

enum ExpensePay {
  CASH_REGISTER
  BANK
  OWNER_CARD
}

enum BookingType {
  BIRTHDAY
  TEAMBUILDING
}

enum BookingStatus {
  NEW
  CONFIRMED
  ARRIVED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ParticipantRole {
  BIRTHDAY_PERSON
  ORGANIZER
  PLAYER
}

enum CertificateStatus {
  SOLD
  ACTIVATED
  EXPIRED
}

enum PhoneChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model MinuteGrant {
  id                String     @id @default(uuid())
  userId            String
  kind              MinuteKind
  seconds           Int
  remainingSeconds  Int
  expiresAt         DateTime?
  source            String
  idempotencyKey    String?    @unique
  loyaltyStatus     LoyaltyStatus?
  transactionId     String?
  sessionId         String?
  createdById       String?
  reason            String?
  createdAt         DateTime   @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries MinuteEntry[]

  @@index([userId, expiresAt])
  @@index([userId, remainingSeconds])
  @@map("minute_grants")
}

model MinuteEntry {
  id          String          @id @default(uuid())
  userId      String
  grantId     String?
  type        MinuteEntryType
  seconds     Int
  reason      String
  sessionId   String?
  createdById String?
  createdAt   DateTime        @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  grant MinuteGrant? @relation(fields: [grantId], references: [id])

  @@index([userId, createdAt])
  @@index([sessionId])
  @@map("minute_entries")
}

model AuthRateLimit {
  key         String    @id
  failCount   Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@map("auth_rate_limits")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

model CatalogItem {
  id                String          @id @default(uuid())
  venueId           String?
  name              String
  category          CatalogCategory
  priceTenge        Int
  /** Цена в выходные; если null — равна будням */
  priceWeekendTenge Int?
  minutes           Int?
  active            Boolean         @default(true)
  trackStock        Boolean         @default(false)
  stockQty          Int             @default(0)
  lowStockAt        Int             @default(10)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([venueId, active])
  @@map("catalog_items")
}

model CashShift {
  id                  String      @id @default(uuid())
  venueId             String
  number              Int
  openedById          String
  closedById          String?
  status              ShiftStatus @default(OPEN)
  openingCash         Int
  previousCloseCash   Int?
  openingNote         String?
  closingCashActual   Int?
  closingKaspi        Int?
  closingHalyk        Int?
  closingFreedom      Int?
  closeComment        String?
  openedAt            DateTime    @default(now())
  closedAt            DateTime?

  sales     Sale[]
  movements CashMovement[]

  @@index([venueId, status])
  @@index([openedById])
  @@map("cash_shifts")
}

model Sale {
  id                String     @id @default(uuid())
  number            Int
  venueId           String
  shiftId           String?
  operatorId        String
  userId            String?
  totalTenge        Int
  minutesCredited   Int        @default(0)
  bonusMinutes      Int        @default(0)
  status            SaleStatus @default(COMPLETED)
  receiptChecked    Boolean    @default(false)
  receiptNumber     String?
  comment           String?
  enteredAfterOutage Boolean   @default(false)
  cancelReason      String?
  cancelledById     String?
  cancelledAt       DateTime?
  transactionId     String?
  createdAt         DateTime   @default(now())

  shift    CashShift?    @relation(fields: [shiftId], references: [id])
  lines    SaleLine[]
  payments SalePayment[]

  @@index([venueId, createdAt])
  @@index([operatorId, createdAt])
  @@index([userId])
  @@index([shiftId])
  @@map("sales")
}

model SaleLine {
  id         String @id @default(uuid())
  saleId     String
  itemId     String?
  name       String
  qty        Int
  priceTenge Int
  minutes    Int    @default(0)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_lines")
}

model SalePayment {
  id           String    @id @default(uuid())
  saleId       String
  method       PayMethod
  amountTenge  Int
  cashReceived Int?
  changeTenge  Int?

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_payments")
}

model CashMovement {
  id         String       @id @default(uuid())
  shiftId    String
  type       CashMoveType
  amount     Int
  article    String?
  comment    String?
  operatorId String
  expenseId  String?
  createdAt  DateTime     @default(now())

  shift CashShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@map("cash_movements")
}

model Expense {
  id          String     @id @default(uuid())
  venueId     String
  occurredOn  DateTime
  amountTenge Int
  category    String
  article     String
  comment     String?
  payMethod   ExpensePay
  shiftId     String?
  createdById String
  cancelledAt DateTime?
  createdAt   DateTime   @default(now())

  @@index([venueId, occurredOn])
  @@map("expenses")
}

model MonthlyPlan {
  id            String @id @default(uuid())
  venueId       String
  year          Int
  month         Int
  planTenge     Int
  overplanTenge Int
  rateBelow     Int
  rateAt        Int
  rateOver      Int
  bookingRate   Int    @default(10)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([venueId, year, month])
  @@map("monthly_plans")
}

model StaffSchedule {
  id         String   @id @default(uuid())
  venueId    String
  userId     String
  startsAt   DateTime
  endsAt     DateTime
  arrivedAt  DateTime?
  leftAt     DateTime?
  replacedBy String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([venueId, startsAt])
  @@index([userId, startsAt])
  @@map("staff_schedules")
}

model Booking {
  id            String        @id @default(uuid())
  venueId       String
  type          BookingType
  startsAt      DateTime
  contactName   String
  contactPhone  String
  packageName   String
  packageMinutes Int
  priceLocked   Int
  people        Int
  amountTenge   Int
  prepayTenge   Int           @default(0)
  broughtById   String
  sourceCode    String
  status        BookingStatus @default(NEW)
  comment       String?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  participants BookingParticipant[]

  @@index([venueId, startsAt])
  @@index([status])
  @@map("bookings")
}

model BookingParticipant {
  id           String          @id @default(uuid())
  bookingId    String
  userId       String?
  isGuest      Boolean         @default(false)
  role         ParticipantRole @default(PLAYER)
  displayName  String?
  creditedAt   DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([userId])
  @@map("booking_participants")
}

model GiftCertificate {
  id           String            @id @default(uuid())
  venueId      String
  code         String            @unique
  title        String
  minutes      Int
  priceTenge   Int
  saleId       String?
  status       CertificateStatus @default(SOLD)
  soldAt       DateTime          @default(now())
  activateBy   DateTime
  activatedAt  DateTime?
  activatedFor String?
  createdById  String

  @@index([status])
  @@map("gift_certificates")
}

model ClientSource {
  id       String  @id @default(uuid())
  code     String  @unique
  label    String
  active   Boolean @default(true)
  sortOrder Int    @default(0)

  @@map("client_sources")
}

model PhoneChangeRequest {
  id          String            @id @default(uuid())
  userId      String
  newPhone    String
  reason      String
  status      PhoneChangeStatus @default(PENDING)
  requestedBy String
  decidedBy   String?
  createdAt   DateTime          @default(now())
  decidedAt   DateTime?

  @@index([status])
  @@map("phone_change_requests")
}

model VisitDay {
  id        String   @id @default(uuid())
  userId    String
  day       String
  createdAt DateTime @default(now())

  @@unique([userId, day])
  @@map("visit_days")
}

model StatusPlay {
  id        String   @id @default(uuid())
  userId    String
  sessionId String
  minutes   Int
  playedAt  DateTime
  createdAt DateTime @default(now())

  @@unique([sessionId, userId])
  @@index([userId, playedAt])
  @@map("status_plays")
}

model StockMove {
  id         String   @id @default(uuid())
  itemId     String
  qty        Int
  kind       String
  reason     String?
  shiftId    String?
  operatorId String?
  createdAt  DateTime @default(now())

  @@index([itemId, createdAt])
  @@map("stock_moves")
}

model TvScreen {
  id          String   @id @default(uuid())
  venueId     String
  keyHash     String
  seconds     Int      @default(15)
  topN        Int      @default(10)
  sponsorOn   Boolean  @default(false)
  sponsorText String?
  ticker      String?
  createdAt   DateTime @default(now())

  @@index([venueId])
  @@map("tv_screens")
}
